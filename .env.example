# College Football Data API (https://collegefootballdata.com/key)
CFBD_API_KEY=

# Groq (https://console.groq.com/keys) — primary AI provider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional AI providers (AIService is provider-swappable)
AI_PROVIDER=groq
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Supabase (optional — enables persistent caching, favorites, realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret for the cron refresh endpoint
CRON_SECRET=change-me
